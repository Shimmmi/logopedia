# App
APP_URL=https://logoped.site
NODE_ENV=production
PORT=3000
SESSION_SECRET=change-me-to-64-hex
APP_ENCRYPTION_KEY=change-me-to-64-hex
STORAGE_ROOT=/var/www/logoped/storage
DEV_SHOW_CODES=false
DEV_UNLIMITED=true
ADMIN_EMAIL=admin@logoped.site
ADMIN_PASSWORD=

# Database / Redis
DATABASE_URL=postgresql://logoped:logoped@postgres:5432/logoped?schema=public
REDIS_URL=redis://redis:6379

# RouterAI (OpenAI-compatible)
AI_BASE_URL=https://routerai.ru/api/v1
AI_API_KEY=
AI_MODEL_BASIC=openai/gpt-4o-mini
AI_MODEL_ADVANCED=openai/gpt-4o
AI_IMAGE_MODEL=google/gemini-3.1-flash-lite-image
AI_IMAGE_QUALITY=medium

# SMTP (leave SMTP_HOST empty for console mailer / dev)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=LogoPed <noreply@logoped.site>

# OAuth — buttons appear only when client id is set
VK_CLIENT_ID=
VK_CLIENT_SECRET=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
MAILRU_CLIENT_ID=
MAILRU_CLIENT_SECRET=
ESIA_CLIENT_ID=
ESIA_CLIENT_SECRET=

# Payments
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# SMS (premium)
SMSAERO_EMAIL=
SMSAERO_API_KEY=

# Speech-to-text fallback
YANDEX_SPEECHKIT_KEY=
YANDEX_SPEECHKIT_FOLDER=

# Web Push (optional)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@logoped.site
